# Vercel environment variables — copy to .env (local dev) or the Vercel dashboard.
# NEVER commit the real .env. This file is safe to commit.

# Supabase Postgres connection string — any of these formats works:
#   Transaction pooler (recommended, port 6543):
#     postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#   Session pooler (port 5432):
#     postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#   Direct connection (port 5432 — also works from Vercel):
#     postgresql://postgres:PASSWORD@db.PROJECT-REF.supabase.co:5432/postgres
# See README → "Full setup guide" for where to find it in the Supabase dashboard.
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"

# Set to 1 on Vercel (auto) or any HTTPS deployment to mark cookies Secure.
# Leave unset for local http dev.
SECURE_COOKIES=""
