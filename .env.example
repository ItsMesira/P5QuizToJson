# Vercel environment variables — copy to .env (local dev) or the Vercel dashboard.
# NEVER commit the real .env. This file is safe to commit.

# Runtime DB connection — the LEAST-PRIVILEGE app role (p5q_app), DML only.
# `node scripts/migrate.mjs` prints the exact URL to .env.approle.
#   postgresql://p5q_app.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://p5q_app.PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Optional: paste the Supabase root CA (PEM) to enable full TLS verification
# (rejectUnauthorized=true). Without it the pooler cert cannot be verified.
DATABASE_CA_CERT=""

# Set to 1 on Vercel (auto) or any HTTPS deployment to mark cookies Secure.
# Leave unset for local http dev.
SECURE_COOKIES=""

# --- Admin bootstrap (used ONCE by scripts/migrate.mjs; never hardcode) ---
# ADMIN_USERNAME="blue"
# ADMIN_PASSWORD_HASH="$argon2id$..."   # 32+ random chars, forced change on first login
# P5Q_APP_PASSWORD="..."                # migration-only: sets the p5q_app role password